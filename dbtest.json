var testShipment = new Shipment({
    ShipmentID: 0001,
    Status: "Pending",
    Order Count: 5
});

testShipment.save((err) => {
    if(err) {
        console.log("There was an error saving the testShipment.");
        } else {
            console.log("The testShipment was saved.");
        }
    process.exit();
});

