<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Customer Search</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="css/styles.css" />
  </head>
  <body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
      <div class="nav">
        <span class="navbar-brand">AA Cards and Collectibles</span>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link" href="/employeepsa">Shipments</a>
            </li>
            <li class="nav-item">
              <a class="nav-link active" href="/employee-search">Customer Search</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/createorder">Create Order</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/createshipment">Create Shipment</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/logout">Log Out</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <div class="container mt-4">
      <h2>Customer Search</h2>

      <form action="/employee-search" method="GET" class="mb-4">
        <div class="input-group">
          <input
            type="text"
            name="name"
            class="form-control"
            placeholder="Search by customer name..."
            value="{{query}}"
            autofocus
          />
          <button type="submit" class="btn btn-primary">Search</button>
        </div>
      </form>

      {{#if error}}
        <div class="alert alert-danger">{{error}}</div>
      {{/if}}

      {{#if customers}}
        {{#if customers.length}}
          {{#each customers}}
            <div class="card mb-4">
              <div class="card-header">
                <strong>{{this.Name}}</strong>
                <span class="text-muted ms-2">@{{this.username}}</span>
                <span class="float-end text-muted">ID: {{this.CustomerID}} &nbsp;|&nbsp; {{this.Email}}</span>
              </div>
              <div class="card-body p-0">
                {{#if this.orders.length}}
                  <table class="table table-striped mb-0">
                    <thead>
                      <tr>
                        <th>Order ID</th>
                        <th>Card Count</th>
                        <th>Order Date</th>
                        <th>Shipment Status</th>
                        <th>Date Shipped</th>
                      </tr>
                    </thead>
                    <tbody>
                      {{#each this.orders}}
                      <tr>
                        <td>{{this.OrderID}}</td>
                        <td>{{this.cardCount}}</td>
                        <td>{{#if this.date}}{{formatDate this.date}}{{/if}}</td>
                        <td>{{this.shipmentStatus}}</td>
                        <td>{{#if this.dateShipped}}{{formatDate this.dateShipped}}{{else}}—{{/if}}</td>
                      </tr>
                      {{/each}}
                    </tbody>
                  </table>
                {{else}}
                  <p class="text-muted p-3 mb-0">No orders for this customer.</p>
                {{/if}}
              </div>
            </div>
          {{/each}}
        {{else}}
          <div class="alert alert-warning">No customers found matching "{{query}}".</div>
        {{/if}}
      {{/if}}
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
